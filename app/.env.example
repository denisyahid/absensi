# Salin file ini menjadi app/.env.local untuk frontend React.
# Kosongkan VITE_API_URL hanya bila backend.php memang tersedia di root origin.
VITE_API_URL=/backend.php

# Hanya dipakai proxy Vite saat `npm run dev`; browser tetap memakai URL relatif.
VITE_PHP_SERVER=http://127.0.0.1:8080

# Variabel berikut bukan variabel Vite. Tambahkan/sesuaikan nilainya di .env
# pada root repository karena app/backend.php membaca file tersebut.
# APP_TIMEZONE=Asia/Jakarta
# APP_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# API_ALLOWED_ORIGINS=http://localhost:5173
# MAIL_MAILER=log
# MAIL_FROM_ADDRESS=noreply@rsudmalangbong.go.id
# MAIL_FROM_NAME="SiHadir RSUD Malangbong"
